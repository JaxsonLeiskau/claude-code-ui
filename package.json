{
  "name": "roundtable",
  "productName": "Roundtable",
  "version": "1.7.1",
  "description": "One place for Claude Code and your other AIs: projects with shared memory, chats with ChatGPT, Gemini and your own model, AI debates, and sync across your computers.",
  "author": "Jaxson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaxsonLeiskau/roundtable.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "electron",
    "desktop",
    "ai",
    "gui",
    "chatgpt",
    "gemini",
    "open-webui"
  ],
  "main": "electron/main.js",
  "bin": {
    "roundtable": "server.js"
  },
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node scripts/smoke-test.js && node scripts/integration-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": ">=33.0.0",
    "electron-builder": ">=25.0.0"
  },
  "build": {
    "appId": "local.claude-code-ui",
    "productName": "Roundtable",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "ai.js",
      "sync.js",
      "commands.js",
      "import.js",
      "public/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "shortcutName": "Roundtable"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "artifactName": "Roundtable-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "JaxsonLeiskau",
        "repo": "roundtable",
        "releaseType": "release"
      }
    ]
  }
}
